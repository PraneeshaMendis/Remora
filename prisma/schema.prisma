generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks   Task[]
  members ProjectMember[]
}

model Task {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  due       DateTime?
  createdAt DateTime  @default(now())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String // ✅ for login with NextAuth
  role         Role     @default(CONSULTANT) // ✅ director, manager, consultant
  createdAt    DateTime @default(now())

  projects ProjectMember[]
}

model ProjectMember {
  projectId  String
  userId     String
  role       String? // e.g., "Manager", "Consultant"
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

enum Role {
  DIRECTOR
  MANAGER
  CONSULTANT
}
